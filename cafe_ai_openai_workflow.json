    {
      "parameters": {
        "jsCode": "const d = $json;\nconst promptSistema = `Eres el asistente de WhatsApp de la cafetería. Responde siempre en español, de forma breve, cálida y profesional.\\nPuedes usar herramientas para: verificar disponibilidad de mesas, crear una reserva, consultar el menú, crear un pedido (cotización + enlace de pago), consultar el estado de un pedido y registrar el feedback del cliente.\\nSi te falta un dato imprescindible (fecha, hora, número de personas, artículos, ID de pedido, calificación), pregúntalo antes de llamar a la herramienta.\\nNunca inventes disponibilidad, precios, artículos del menú ni el estado de un pedido: esa información solo puede venir de las herramientas.`;\nreturn [{ json: {\n  telefono: d.telefono,\n  nombre: d.nombre,\n  texto: d.texto,\n  mensajes: [\n    { role: \"system\", content: promptSistema },\n    { role: \"user\", content: d.texto || \"\" }\n  ]\n} }];"
      },
      "id": "n03", "name": "Construir Mensajes", "type": "n8n-nodes-base.code", "typeVersion": 2,
      "position": [-1952, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
