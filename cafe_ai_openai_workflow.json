            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({\n  model: $env.OPENAI_MODEL || 'gpt-4o-mini',\n  messages: $json.mensajes,\n  tool_choice: 'auto',\n  tools: [\n    { type: 'function', function: { name: 'verificar_disponibilidad', description: 'Verifica si hay mesas disponibles para una fecha, hora y número de personas.', parameters: { type: 'object', properties: { fecha: { type: 'string', description: 'YYYY-MM-DD' }, hora: { type: 'string', description: 'HH:MM' }, personas: { type: 'integer' } }, required: ['fecha','hora','personas'] } } },\n    { type: 'function', function: { name: 'crear_reserva', description: 'Crea una reserva de mesa después de confirmar disponibilidad.', parameters: { type: 'object', properties: { fecha: { type: 'string' }, hora: { type: 'string' }, personas: { type: 'integer' } }, required: ['fecha','hora','personas'] } } },\n    { type: 'function', function: { name: 'consultar_menu', description: 'Obtiene el menú actual de la cafetería con categorías, artículos y precios.', parameters: { type: 'object', properties: {} } } },\n    { type: 'function', function: { name: 'crear_pedido', description: 'Cotiza un pedido a partir de los artículos solicitados y genera un enlace de pago.', parameters: { type: 'object', properties: { items: { type: 'array', description: 'Artículos del pedido', items: { type: 'object', properties: { nombre: { type: 'string' }, cantidad: { type: 'integer' } }, required: ['nombre','cantidad'] } } }, required: ['items'] } } },\n    { type: 'function', function: { name: 'consultar_estado_pedido', description: 'Consulta el estado actual de un pedido por su ID.', parameters: { type: 'object', properties: { pedido_id: { type: 'string' } }, required: ['pedido_id'] } } },\n    { type: 'function', function: { name: 'registrar_feedback', description: 'Guarda la calificación y el comentario del cliente sobre su experiencia.', parameters: { type: 'object', properties: { calificacion: { type: 'integer', description: '1 a 5' }, comentario: { type: 'string' } }, required: ['calificacion'] } } }\n  ]\n})}}",
        "options": {}
