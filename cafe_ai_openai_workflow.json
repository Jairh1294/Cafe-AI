    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nconst m = b.messages?.[0] ?? b.message ?? b;\nconst c = b.contacts?.[0] ?? {};\nreturn [{ json: {\n  telefono: m.from ?? b.from ?? b.phone ?? \"\",\n  nombre: c.profile?.name ?? b.name ?? \"\",\n  texto: m.text?.body ?? m.text ?? b.text ?? \"\",\n  raw: b\n} }];"
