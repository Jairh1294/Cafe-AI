    {
      "parameters": {
        "jsCode": "const msg = $json.choices?.[0]?.message ?? {};\nconst toolCalls = msg.tool_calls;\nif (Array.isArray(toolCalls) && toolCalls.length > 0) {\n  return [{ json: {\n    tiene_herramienta: true,\n    mensaje_asistente: msg,\n    tool_call: toolCalls[0]\n  } }];\n}\nreturn [{ json: {\n  tiene_herramienta: false,\n  respuesta: msg.content || 'Disculpa, ¿podrías repetirlo?'\n} }];"
